# Copia este fichero a .env y rellena los valores. .env está en .gitignore.
# En producción (Vercel / GitHub Actions) estos valores van como secrets,
# nunca como fichero.

# Token personal del EuroLeague Fantasy Challenge (formato "1234567|cadena").
# Cómo obtenerlo: docs/TOKEN.md
FANTAKING_TOKEN=

# Id de tu equipo fantasy, visible en la URL de la app oficial.
EFA_FANTASY_TEAM_ID=

# Id interno de jornada de Fantaking. Opcional: si no se define, se estima
# desde el calendario oficial. Ver docs/TOKEN.md para fijarlo con certeza.
EFA_MATCHDAY_ID=

# Temporadas. Normalmente no hace falta tocarlas.
EFA_SEASON_CODE=E2026
EFA_PRIOR_SEASON_CODE=E2025
